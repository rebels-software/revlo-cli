/* Revlo TUI stylesheet */

Screen {
    background: #0A1628;
    layout: vertical;
}

/* -- Brand header --------------------------------------------------------- */

#brand-header {
    width: 100%;
    height: 4;
    background: #0A1628;
    padding: 1 2 1 2;
    color: #E8ECF1;
    border-bottom: solid #2A3A50;
}

#header-left {
    width: 1fr;
    height: 100%;
    content-align: left middle;
}

#header-center {
    width: auto;
    height: 100%;
    content-align: center middle;
}

#header-right {
    width: 1fr;
    height: 100%;
    content-align: right middle;
    text-align: right;
}

/* -- Main container ------------------------------------------------------- */

#main-container {
    width: 100%;
    height: 1fr;
    background: #0A1628;
}

/* -- Sidebar -------------------------------------------------------------- */

#sidebar {
    width: 40;
    min-width: 32;
    max-width: 56;
    height: 100%;
    background: #0A1628;
    background-tint: transparent;
    border-right: solid #2A3A50;
    scrollbar-size: 0 0;
}

#sidebar:focus {
    background: #0A1628;
    background-tint: transparent;
}

#sidebar > ListItem {
    padding: 0 1;
    height: auto;
}

#sidebar > ListItem:hover {
    background: #162240;
}

#sidebar > ListItem.-highlight {
    background: #1A2D4D;
}

SeverityGroupHeader {
    background: #0A1628;
    padding: 1 1 0 1;
    height: auto;
    opacity: 1.0;
}

SeverityGroupHeader:hover {
    background: #0A1628;
}

SeverityGroupHeader.-highlight {
    background: #0A1628;
}

SeverityGroupHeader:disabled {
    background: #0A1628;
    opacity: 1.0;
}

#sidebar > FindingItem {
    padding: 0 1 0 4;
    background: #0A1628;
}

.group-header-label {
    text-style: bold;
}

.finding-label {
    width: 1fr;
}

/* -- Detail panel --------------------------------------------------------- */

#detail-panel {
    width: 1fr;
    height: 100%;
    background: #0A1628;
    padding: 1 2;
    overflow-y: auto;
    scrollbar-color: #2A3A50;
    scrollbar-color-hover: #00D4AA;
    scrollbar-background: #0A1628;
}

#detail-placeholder {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
}

#detail-content {
    display: none;
    width: 1fr;
    margin-bottom: 1;
}

#detail-description {
    display: none;
    width: 1fr;
    border: solid #2A3A50;
    border-title-color: #00D4AA;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 0 1 0;
    color: #E8ECF1;
}

#detail-recommendation {
    display: none;
    width: 1fr;
    border: solid #2A3A50;
    border-title-color: #FFB347;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 0 1 0;
    color: #E8ECF1;
}

/* -- Chat panel ----------------------------------------------------------- */

#chat-panel {
    width: 1fr;
    height: 100%;
    background: #0A1628;
    padding: 1 2;
}

#chat-header {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#chat-scroll {
    width: 1fr;
    height: 1fr;
    background: #0A1628;
    scrollbar-color: #2A3A50;
    scrollbar-color-hover: #00D4AA;
    scrollbar-background: #0A1628;
}

#chat-input {
    width: 1fr;
    height: 3;
    margin-top: 1;
    background: #0F1929;
    color: #E8ECF1;
    border: solid #2A3A50;
}

#chat-input:focus {
    border: solid #00D4AA;
}

.chat-context-banner {
    width: 1fr;
    padding: 0 1;
    margin-bottom: 1;
    color: #6B7B8D;
}

/* -- Empty state ---------------------------------------------------------- */

#empty-state {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
}

/* -- Filter bar ----------------------------------------------------------- */

#filter-bar {
    width: 100%;
    height: 4;
    background: #0A1628;
    padding: 0 2;
    content-align: center middle;
    color: #E8ECF1;
    border-top: solid #2A3A50;
}

#filter-left {
    width: auto;
    height: 100%;
    content-align: left middle;
}

#filter-center {
    width: 1fr;
    height: 100%;
    content-align: left middle;
}

#filter-right {
    width: 1fr;
    height: 100%;
    content-align: right middle;
    text-align: right;
}
